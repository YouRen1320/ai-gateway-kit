# Project identity
COMPOSE_PROJECT_NAME=ai-gateway
GATEWAY_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
ADMIN_EMAIL=admin@example.com
TZ=UTC
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# 基础镜像固定摘要复核于 2026-09-20；Sub2API 保留既有版本，单独评估迁移。
# Upgrade only through ./bin/upgrade so the previous image is recorded.
SUB2API_IMAGE=weishaw/sub2api:0.1.151@sha256:2ca591c2af97eb0e2797cfc7fb7bd587194d94cebdac76f73d677eeab1d4d6c8
POSTGRES_IMAGE=postgres:18.6-alpine3.24@sha256:6c538e7206ea40ff740ef27883529390a690b6ead6ba96b44c67a9f7c638e8fd
REDIS_IMAGE=redis:8.8.2-alpine3.23@sha256:e2c307e77bcaf306fa9e468bda845165a46c4c015ffd238fb3c92ae5d71d486f
CADDY_IMAGE=caddy:2.11.4-alpine@sha256:de23def33b17fb5d1290b0f6c2add1d70780e52341896c00a4c8a2a2fe9d355e

# Local access. Production traffic should enter through Caddy or another TLS proxy.
BIND_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_MODE=release
RUN_MODE=standard
SIMPLE_MODE_CONFIRM=false

# Generated by ./bin/setup. Never reuse these placeholders.
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=REPLACE_BY_SETUP
POSTGRES_DB=sub2api
REDIS_PASSWORD=REPLACE_BY_SETUP
ADMIN_PASSWORD=REPLACE_BY_SETUP
JWT_SECRET=REPLACE_BY_SETUP
TOTP_ENCRYPTION_KEY=REPLACE_BY_SETUP

# Conservative defaults for a small single-node deployment.
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5
REDIS_DB=0
REDIS_POOL_SIZE=256
REDIS_MIN_IDLE_CONNS=10
JWT_EXPIRE_HOUR=24
SETUP_MIGRATION_TIMEOUT_SECONDS=300

# Request and log limits.
SERVER_MAX_REQUEST_BODY_SIZE=268435456
GATEWAY_MAX_BODY_SIZE=268435456
MAX_REQUEST_BODY_SIZE=256MB
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT_TO_STDOUT=true
LOG_OUTPUT_TO_FILE=true
LOG_ROTATION_MAX_SIZE_MB=100
LOG_ROTATION_MAX_BACKUPS=10
LOG_ROTATION_MAX_AGE_DAYS=7

# Production-safe URL handling. Add reviewed custom provider hosts before use.
SECURITY_URL_ALLOWLIST_ENABLED=true
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=false
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false
SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=api.openai.com,api.anthropic.com,api.kimi.com,open.bigmodel.cn,api.minimaxi.com,generativelanguage.googleapis.com,cloudcode-pa.googleapis.com,*.openai.azure.com
SECURITY_URL_ALLOWLIST_PRICING_HOSTS=raw.githubusercontent.com
SECURITY_URL_ALLOWLIST_CRS_HOSTS=

# Optional provider configuration. Prefer official, authorized API credentials.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
GEMINI_OAUTH_SCOPES=
UPDATE_PROXY_URL=
